# Template env for local development.
# Copy to .env.local and fill in your own keys. Do not commit .env.local.

# App
NODE_ENV=development
LOG_LEVEL=info
APP_ORIGIN=http://localhost:3000
API_ORIGIN=http://localhost:3001
VITE_API_ORIGIN=http://localhost:3001
WS_ORIGIN=ws://localhost:3001

# Database
DATABASE_URL=postgres://postgres:postgres@localhost:5432/agent_chat
PGVECTOR_ENABLED=true

# Redis / Queue
REDIS_URL=redis://localhost:6379
QUEUE_PREFIX=agent-chat

# BullMQ Worker
BULLMQ_ENABLED=false
WORKER_CONCURRENCY=1
WORKER_SESSION_TIMEOUT_MS=300000

# Sessions
SESSION_MAX_ROUNDS=120

# Object Storage (MinIO)
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=agent-chat-dev
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin

# AI
RUNTIME_MODEL_PROVIDER=openai
RUNTIME_MODEL_TIMEOUT_MS=30000

OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL_CHAT=gpt-5.4
OPENAI_RESPONSES_STREAM=false
OPENAI_MODEL_EMBEDDING=text-embedding-3-large

ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=https://api.anthropic.com/v1
ANTHROPIC_MODEL_CHAT=claude-sonnet-4-5

OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL_CHAT=qwen2.5:14b

# Security
JWT_SECRET=change-this-in-local
JWT_ACCESS_EXPIRES_IN=900
JWT_REFRESH_EXPIRES_IN=604800
CONTENT_MODERATION_ENABLED=true

# Admin
ADMIN_ORIGIN=http://localhost:3002
# Admin shares API origin from `VITE_API_ORIGIN` above.
ADMIN_INITIAL_PASSWORD=admin123
