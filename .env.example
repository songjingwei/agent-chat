# App
NODE_ENV=development
LOG_LEVEL=info
APP_ORIGIN=http://localhost:3000
API_ORIGIN=http://localhost:3001
WS_ORIGIN=ws://localhost:3001

# Database
DATABASE_URL=postgres://postgres:postgres@localhost:5432/agent_chat
PGVECTOR_ENABLED=true

# Redis / Queue
REDIS_URL=redis://localhost:6379
QUEUE_PREFIX=agent-chat

# Object Storage (MinIO)
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=agent-chat-dev
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin

# AI
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL_CHAT=gpt-5.4
OPENAI_MODEL_EMBEDDING=text-embedding-3-large

# Security
JWT_SECRET=change-this-in-local
JWT_ACCESS_EXPIRES_IN=900
JWT_REFRESH_EXPIRES_IN=604800
CONTENT_MODERATION_ENABLED=true
